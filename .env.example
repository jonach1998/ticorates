BCCR_API_KEY=your_token_here
BCCR_BASE_URL=https://apim.bccr.fi.cr/SDDE/api/Bccr.GE.SDDE.Publico.Indicadores.API

# Optional — change the SQLite database path (default: /app/data/ticorates.db)
# DATABASE_URL=sqlite:////custom/path/ticorates.db

# Optional — only count requests carrying this header in the Prometheus /metrics.
# Behind a trusted proxy (e.g. Cloudflare) set it to exclude internal traffic
# (scrapes, healthchecks). Leave unset to count every request.
# METRICS_TRUSTED_HEADER=CF-Connecting-IP
